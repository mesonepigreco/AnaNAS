[Unit]
Description=anaNAS desktop panel controls
After=graphical-session.target nas-sync.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/nas-sync-indicator --config %h/.config/nas-sync/config.json
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
UMask=0077
CPUQuota=50%
MemoryHigh=64M
MemoryMax=96M

[Install]
WantedBy=graphical-session.target
