{
  "sync": {"enabled": false},
  "local": {
    "root": "/home/me/Documents/sync"
  },
  "nas": {
    "host": "192.168.1.50",
    "share": "nas-sync",
    "mountPoint": "/mnt/nas-sync",
    "protocol": "smb",
    "interface": "enp3s0",
    "prefix": "192.168.1.0/24"
  },
  "remote": {
    "enabled": false,
    "host": "nas.example.com",
    "port": 22,
    "user": "darth",
    "keyFile": "/home/me/.ssh/id_ed25519",
    "knownHosts": "/home/me/.ssh/known_hosts"
  },
  "coalesce": {
    "idle": "1.5s",
    "maxWait": "5s",
    "maxPending": 10000,
    "maxBytes": 4194304
  },
  "selectiveSync": {
    "excludeLocal": [
      "node_modules/",
      "*.tmp"
    ],
    "excludeRemote": []
  },
  "lanGuard": true,
  "scanRemote": "15m",
  "blockSize": 65536,
  "webPort": 8721,
  "limits": {
    "readBytesPerSecond": 20971520,
    "scanOpsPerSecond": 50,
    "maxWatches": 100000,
    "cacheBytes": 1073741824
  },
  "stateDir": ""
}
